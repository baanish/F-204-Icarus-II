// Full-afterburner endurance from full internal fuel. R14 predicts 300 to 306 s: 2,400 kg at 5.50 kg per check of afterburner
// plus 2.50 of core at full throttle, drawn about once a second; afterburner fuel doesn't fall with density, so altitude
// doesn't matter. The Icarus starts over Ignus at 10 km heading east at 650 m/s, full fuel, clean, at throttle 1. About 715 m/s
// for 300 s is 215 km, more than the map's 164 km, so after 140 s the hold reverses onto west in 15 deg heading steps every 8 s,
// a 96 s turn of about 21 km radius, well inside the map. (A single 90 deg heading command pulled 4.8 g at Mach 2.4.)
// Pass: fuel lasts at least 285 s and runs out by 315 s (300 s +- 5%); the airframe intact 5 s after spawn, else FAIL.
// Seconds to empty is the t of the "fuel at empty" record minus the t of the "fuel at the start" record in verdict.json.
// From the repo root: no-agentic run tests/scenarios/afterburner_endurance.scenario.jsonc
{
  "mission": "icarus_ignus_10km.mission.json",
  "mods": "clean",
  "plugins": [
    "installed:com.nikkorap.blueprinter",
    "../../.cache/build-staging/dotnet",
    "content:../../build/icarus_0.0.1.nobp host=com.nikkorap.blueprinter keys=baanish_icarus",
  ],
  "measure": true,
  "sample_hz": 2,
  "timeout": 480,
  "steps": [
    { "require": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.type", "eq": "baanish_icarus" }, { "path": "own.alt_msl_m", "gt": 9500 },
                            { "path": "own.fuel_frac", "gt": 0.99 } ] }, "label": "the Icarus airborne at 10 km with full fuel" },
    { "mark": { "label": "start" } },
    { "check": { "all": [ { "path": "own.hp_frac", "eq": 1 }, { "not": { "event": "part_detached", "since": "start" } } ] }, "for": 5,
      "label": "the airframe is intact 5 s after spawn" },
    { "require": { "path": "own.hp_frac", "eq": 1 }, "label": "gate: the steps after need an intact airframe" },
    { "fly": { "mode": "hold", "alt_msl_m": 10000, "hdg_deg": 90, "throttle": 1 } },
    { "wait": { "path": "own.engines.0.rpm_frac", "gt": 0.99 }, "timeout": 10, "label": "the engine at full RPM" },
    { "time": { "scale": 4 } },
    { "mark": { "label": "burn" } },
    { "record": { "path": "own.fuel_frac" }, "label": "fuel at the start of the burn (its t starts the clock)" },
    { "check": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.fuel_frac", "gt": 0.002 } ] }, "for": 140, "label": "140 s east at full afterburner" },
    { "record": { "path": "own.fuel_frac" }, "label": "fuel after 140 s (R14: 0.533)" },
    { "record": { "path": "own.pos.x" }, "label": "x after 140 s, m" },
    { "fly": { "mode": "hold", "alt_msl_m": 10000, "hdg_deg": 75, "throttle": 1 } },
    { "check": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.fuel_frac", "gt": 0.002 } ] }, "for": 8, "label": "turning: heading 075" },
    { "fly": { "mode": "hold", "alt_msl_m": 10000, "hdg_deg": 60, "throttle": 1 } },
    { "check": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.fuel_frac", "gt": 0.002 } ] }, "for": 8, "label": "turning: heading 060" },
    { "fly": { "mode": "hold", "alt_msl_m": 10000, "hdg_deg": 45, "throttle": 1 } },
    { "check": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.fuel_frac", "gt": 0.002 } ] }, "for": 8, "label": "turning: heading 045" },
    { "fly": { "mode": "hold", "alt_msl_m": 10000, "hdg_deg": 30, "throttle": 1 } },
    { "check": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.fuel_frac", "gt": 0.002 } ] }, "for": 8, "label": "turning: heading 030" },
    { "fly": { "mode": "hold", "alt_msl_m": 10000, "hdg_deg": 15, "throttle": 1 } },
    { "check": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.fuel_frac", "gt": 0.002 } ] }, "for": 8, "label": "turning: heading 015" },
    { "fly": { "mode": "hold", "alt_msl_m": 10000, "hdg_deg": 0, "throttle": 1 } },
    { "check": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.fuel_frac", "gt": 0.002 } ] }, "for": 8, "label": "turning: heading 000" },
    { "fly": { "mode": "hold", "alt_msl_m": 10000, "hdg_deg": 345, "throttle": 1 } },
    { "check": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.fuel_frac", "gt": 0.002 } ] }, "for": 8, "label": "turning: heading 345" },
    { "fly": { "mode": "hold", "alt_msl_m": 10000, "hdg_deg": 330, "throttle": 1 } },
    { "check": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.fuel_frac", "gt": 0.002 } ] }, "for": 8, "label": "turning: heading 330" },
    { "fly": { "mode": "hold", "alt_msl_m": 10000, "hdg_deg": 315, "throttle": 1 } },
    { "check": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.fuel_frac", "gt": 0.002 } ] }, "for": 8, "label": "turning: heading 315" },
    { "fly": { "mode": "hold", "alt_msl_m": 10000, "hdg_deg": 300, "throttle": 1 } },
    { "check": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.fuel_frac", "gt": 0.002 } ] }, "for": 8, "label": "turning: heading 300" },
    { "fly": { "mode": "hold", "alt_msl_m": 10000, "hdg_deg": 285, "throttle": 1 } },
    { "check": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.fuel_frac", "gt": 0.002 } ] }, "for": 8, "label": "turning: heading 285" },
    { "fly": { "mode": "hold", "alt_msl_m": 10000, "hdg_deg": 270, "throttle": 1 } },
    { "check": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.fuel_frac", "gt": 0.002 } ] }, "for": 8, "label": "turning: heading 270" },
    { "check": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.fuel_frac", "gt": 0.002 } ] }, "for": 49,
      "label": "fuel lasts at least 285 s at full afterburner" },
    { "wait": { "path": "own.fuel_frac", "lt": 0.002 }, "timeout": 30, "label": "fuel runs out by 315 s" },
    { "record": { "path": "own.fuel_frac" }, "label": "fuel at empty (its t stops the clock)" },
    { "record": { "path": "own.pos.x" }, "label": "x at empty, m" },
    { "record": { "path": "own.pos.z" }, "label": "z at empty, m (map edge 40,960)" },
    { "time": { "scale": 1 } },
  ],
}
