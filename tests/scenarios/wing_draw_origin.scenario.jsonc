// Drawn wing seams near the world origin: the Icarus, full tip tanks and fuel, starts 2 km west of the origin at 3,000 m and
// 300 m/s (icarus_ignus_origin_tanks.mission.json), and the hold turns it hard through 180 degrees and back, past 8 g,
// within a few km of the origin. src/Icarus/WingSkinFollow.cs draws each wing part on the part it hangs from while they
// are jointed, and the tail cone on the aft core with the afterburner and nozzle on it; its "wing-skin-<piece>",
// "wing-draw-<part>" and "tail-draw-<part>" lines give each part's drawn and physical offset off its rest in the frame
// of the part its seam meets (the inner box, the aft core, the tail cone), with ulp_mm, the float32 spacing of world positions there, a fraction of a millimetre
// here against 7.8 mm 77 km out. tools/flight_peaks.py reads the peaks.
// From the repo root: no-agentic run tests/scenarios/wing_draw_origin.scenario.jsonc
{
  "mission": "icarus_ignus_origin_tanks.mission.json",
  "mods": "clean",
  "plugins": [
    "installed:com.nikkorap.blueprinter",
    "../../.cache/build-staging/dotnet",
    "content:../../build/icarus_0.1.0.nobp host=com.nikkorap.blueprinter keys=baanish_icarus",
  ],
  "measure": true,
  "sample_hz": 20,
  "timeout": 120,
  "steps": [
    { "require": { "path": "mods.baanish.icarus.loadout", "eq": "baanish_icarus_tip_tank||" }, "within": 3,
      "label": "loadout: tip tanks only, inner and conformal sets empty" },
    { "require": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.type", "eq": "baanish_icarus" }, { "path": "own.alt_msl_m", "gt": 2800 } ] },
      "label": "the Icarus airborne at 3 km" },
    { "mark": { "label": "turn" } },
    { "fly": { "mode": "hold", "alt_msl_m": 3000, "hdg_deg": 270, "throttle": 1 } },
    { "wait": { "path": "own.load_g", "gt": 8 }, "timeout": 10, "label": "the hold pulls past 8 g" },
    { "wait": { "path": "own.alive", "eq": true }, "hold": 8, "timeout": 10, "label": "8 s through the turn onto 270" },
    { "fly": { "mode": "hold", "alt_msl_m": 3000, "hdg_deg": 90, "throttle": 1 } },
    { "wait": { "path": "own.alive", "eq": true }, "hold": 10, "timeout": 12, "label": "10 s through the turn back onto 090" },
    { "record": { "path": "own.pos.x" }, "label": "x at the end, m" },
  ],
}
