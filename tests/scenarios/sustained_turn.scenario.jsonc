// Energy change in a hard turn: guard the game's measured behaviour at 478.8 m/s, with the same 10 m/s tolerance
// (468.8 to 488.8 m/s). Reference results are 478.55 m/s in the release build, 478.18 in the baseline and 478.78 in a repeat.
// The offline point-mass model at 10 km, 400 m/s and 9 g gives forward thrust 88,453.764 N and drag 92,461.766 N:
// (88,453.764 - 92,461.766) / 7,897 = -0.507535 m/s2; 400 - 0.507535 x 10 = 394.925 m/s, about 394.9.
// The measured 478.8 is about 21% higher than that prediction, while the same model matches 10 km level speed within 3%.
// Model inputs: 6,356 kg empty + half of 3,082 kg fuel; 90/45 kN core/afterburner;
// engine maxSpeed 760 m/s and altitude factors 1/.8/.55/.3 at 0/10/15/19 km; areas 20.8079/3/2 m2, anhedral 10 deg,
// dragArea 0.47, and the current airfoil curves in IcarusAuthor.Identity.cs. The model omits pitch trim, moving surfaces,
// acceleration before the turn and the autopilot's changing load, so this turn check uses the measured reference.
// The runner cannot command 9 g: wait for over 8 g, record the actual load and speed, then observe two five-second holds.
// Pass: intact after spawn and the pull, TAS within 10 m/s of 478.8, altitude within 500 m, nothing detached.
// From the repo root: no-agentic run tests/scenarios/sustained_turn.scenario.jsonc --realtime
{
  "mission": "icarus_ignus_10km_half.mission.json",
  "mods": "clean",
  "plugins": [
    "installed:com.nikkorap.blueprinter",
    "../../.cache/build-staging/dotnet",
    "content:../../build/icarus_0.3.0.nobp host=com.nikkorap.blueprinter keys=baanish_icarus",
  ],
  "measure": true,
  "sample_hz": 20,
  "timeout": 180,
  "steps": [
    { "require": { "path": "mods.baanish.icarus.loadout", "eq": "|||" }, "within": 3,
      "label": "loadout: all four hardpoint sets empty" },
    { "require": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.type", "eq": "baanish_icarus" }, { "path": "own.alt_msl_m", "gt": 9500 } ] },
      "label": "the Icarus airborne at 10 km" },
    { "mark": { "label": "start" } },
    { "check": { "all": [ { "path": "own.hp_frac", "eq": 1 }, { "not": { "event": "part_detached", "since": "start" } } ] }, "for": 5,
      "label": "the airframe is intact 5 s after spawn" },
    { "require": { "path": "own.hp_frac", "eq": 1 }, "label": "gate: the steps after need an intact airframe" },
    { "fly": { "mode": "hold", "alt_msl_m": 10000, "hdg_deg": 90, "throttle": 1 } },
    { "wait": { "path": "own.engines.0.rpm_frac", "gt": 0.99 }, "timeout": 10, "label": "the engine at full RPM" },
    { "mark": { "label": "turn" } },
    { "record": { "path": "own.tas_mps" }, "label": "TAS at the start of the turn, m/s" },
    { "fly": { "mode": "hold", "alt_msl_m": 10000, "hdg_deg": 300, "throttle": 1 } },
    { "wait": { "any": [ { "path": "own.load_g", "gt": 8 }, { "event": "part_detached", "since": "turn" } ] }, "timeout": 8,
      "label": "the hold pulls the turn past 8 g (or a part comes off first)" },
    { "check": { "all": [ { "not": { "event": "part_detached", "since": "turn" } }, { "path": "own.hp_frac", "eq": 1 } ] },
      "label": "the airframe holds together on the way to 8 g" },
    { "require": { "path": "own.load_g", "gt": 8 }, "label": "gate: the hold pulled past 8 g" },
    { "record": { "path": "own.load_g" }, "label": "load once past 8 g" },
    { "record": { "path": "own.tas_mps" }, "label": "TAS once past 8 g, m/s" },
    { "wait": { "path": "own.alive", "eq": true }, "timeout": 6, "hold": 5, "label": "5 s on in the turn" },
    { "record": { "path": "own.load_g" }, "label": "load 5 s on" },
    { "record": { "path": "own.tas_mps" }, "label": "TAS 5 s on, m/s" },
    { "wait": { "path": "own.alive", "eq": true }, "timeout": 6, "hold": 5, "label": "10 s on in the turn" },
    { "record": { "path": "own.load_g" }, "label": "load 10 s on" },
    { "record": { "path": "own.tas_mps" }, "label": "TAS 10 s on, m/s" },
    { "record": { "path": "own.alt_msl_m" }, "label": "altitude 10 s on, m" },
    { "record": { "path": "own.aoa_deg" }, "label": "AoA 10 s on, deg" },
    { "check": { "all": [ { "path": "own.tas_mps", "near": 478.8, "tol": 10 }, { "path": "own.alt_msl_m", "near": 10000, "tol": 500 },
                          { "not": { "event": "part_detached", "since": "turn" } } ] },
      "label": "about 10 s into the turn: TAS within 10 m/s of the measured 478.8, altitude within 500 m, nothing detached" },
  ],
}
