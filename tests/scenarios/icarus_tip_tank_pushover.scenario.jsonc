// Tip tank release in a pushover: the Icarus flies level at 10,000 m with a full tip tank on each wingtip
// (icarus_tip_tanks.mission.json), settles, then the hold is sent down to 9,000 m. The nose-over unloads
// the jet well under 1 g; the tanks are released the moment the load falls under 0.6 g. A tank that struck the wing or
// the tail in a below-1 g transient shows as a part contact in the Icarus's stage log; each round's spawn place and attitude
// are checked too (the plugin turns the right tank upright, src/Icarus/TipTanks.cs). Pass: both tanks release, the Icarus takes no damage and no part
// contact is logged for 10 s after the release, and no joint breaks. The load at the release is recorded.
// From the repo root: no-agentic run tests/scenarios/icarus_tip_tank_pushover.scenario.jsonc
{
  "mission": "icarus_tip_tanks.mission.json",
  "mods": "clean",
  "plugins": [
    "installed:com.nikkorap.blueprinter",
    "../../.cache/build-staging/dotnet",
    "content:../../build/icarus_0.1.0.nobp host=com.nikkorap.blueprinter keys=baanish_icarus",
  ],
  "timeout": 240,
  "steps": [
    { "require": { "path": "mods.baanish.icarus.loadout", "eq": "baanish_icarus_tip_tank||" }, "within": 3,
      "label": "loadout: tip tanks only, inner and conformal sets empty" },
    { "require": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.type", "eq": "baanish_icarus" } ] }, "label": "the Icarus is the player's aircraft" },
    { "mark": { "label": "start" } },
    { "fly": { "mode": "hold", "alt_msl_m": 10000, "hdg_deg": 90, "throttle": 0.8 } },
    { "wait": { "path": "own.alive", "eq": true }, "timeout": 50, "hold": 40, "label": "flying the hold; the join notice has gone" },
    { "act": { "station": 0 } },
    { "check": { "all": [ { "path": "own.station.name", "eq": "Tip Tank" }, { "path": "own.station.ammo", "eq": 2 }, { "path": "own.station.safety", "eq": false } ] },
      "within": 3, "label": "the tank station is selected with both tanks, safety off" },
    { "camera": { "mode": "orbit", "target": "own", "distance_m": 24, "hdg_deg": 240, "pitch_deg": -8 } },
    { "fly": { "mode": "hold", "alt_msl_m": 9000, "hdg_deg": 90, "throttle": 0.8 } },
    { "wait": { "path": "own.load_g", "lt": 0.6 }, "timeout": 30, "label": "unloaded under 0.6 g in the pushover" },
    { "mark": { "label": "release" } },
    { "record": { "path": "own.load_g" }, "label": "load at the release, g" },
    { "act": { "fire": 0.2 } },
    { "check": { "log_value": { "match": "^\\[Icarus\\] tip-tanks-release: tip tank L released with (\\d+) kg", "source": "F-204 Icarus II", "since": "release", "gt": 300 } },
      "within": 3, "label": "the left tank released with its fuel" },
    { "check": { "log_value": { "match": "^\\[Icarus\\] tip-tanks-release: tip tank R released with (\\d+) kg", "source": "F-204 Icarus II", "since": "release", "gt": 300 } },
      "within": 3, "label": "the right tank went with it" },
    { "check": { "log_value": { "match": "^\\[Icarus\\] tip-tanks-round: tip tank round L from \\d+ dressed in the jet's livery, spawned at \\((-?[\\d.]+),", "source": "F-204 Icarus II", "since": "release", "between": [-4.1, -3.85] } },
      "within": 5, "label": "the left round spawns 0.3 m outboard of its hung place" },
    { "check": { "log_value": { "match": "^\\[Icarus\\] tip-tanks-round: tip tank round L .*, up (-?[\\d.]+)$", "source": "F-204 Icarus II", "since": "release", "gt": 0.999 } },
      "within": 5, "label": "the left round spawns upright" },
    { "check": { "log_value": { "match": "^\\[Icarus\\] tip-tanks-round: tip tank round R from \\d+ dressed in the jet's livery, spawned at \\((-?[\\d.]+),", "source": "F-204 Icarus II", "since": "release", "between": [3.85, 4.1] } },
      "within": 5, "label": "the right round spawns 0.3 m outboard of its hung place" },
    { "check": { "log_value": { "match": "^\\[Icarus\\] tip-tanks-round: tip tank round R .*, up (-?[\\d.]+)$", "source": "F-204 Icarus II", "since": "release", "gt": 0.999 } },
      "within": 5, "label": "the right round spawns upright" },
    { "screenshot": { "name": "pushover_release" } },
    { "check": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.hp_frac", "gt": 0.999 }, { "not": { "event": "damage", "since": "release" } },
                          { "not": { "log": "] contact ", "source": "F-204 Icarus II", "since": "release" } } ] }, "for": 10,
      "label": "no damage and no part contact for 10 s after the release" },
    { "check": { "not": { "log": "joint-break", "since": "start" } }, "label": "no joint broke all run" },
  ],
}
