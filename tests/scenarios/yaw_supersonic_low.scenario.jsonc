// Low-altitude supersonic yaw: the Icarus at 3,000 m (about 10,000 ft) over Ignus, heading east at 480 m/s, about
// Mach 1.46, held level at full afterburner, then stepped 20 degrees right and back, at 20 Hz, so the yaw rate and sideslip trace
// show any directional oscillation the steps excite. Thrust vectoring as shipped.
// Measured only. From the repo root: no-agentic run tests/scenarios/yaw_supersonic_low.scenario.jsonc
{
  "mission": "icarus_ignus_3km_fast.mission.json",
  "mods": "clean",
  "plugins": [
    "installed:com.nikkorap.blueprinter",
    "../../.cache/build-staging/dotnet",
    "content:../../build/icarus_0.1.0.nobp host=com.nikkorap.blueprinter keys=baanish_icarus",
  ],
  "measure": true,
  "sample_hz": 20,
  "timeout": 180,
  "steps": [
    { "require": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.type", "eq": "baanish_icarus" }, { "path": "own.alt_msl_m", "gt": 2500 } ] },
      "label": "the Icarus airborne at 3 km" },
    { "fly": { "mode": "hold", "alt_msl_m": 3000, "hdg_deg": 90, "throttle": 1 } },
    { "check": { "path": "own.alive", "eq": true }, "for": 15, "label": "15 s level at full afterburner" },
    { "mark": { "label": "turn" } },
    { "fly": { "mode": "hold", "alt_msl_m": 3000, "hdg_deg": 110, "throttle": 1 } },
    { "check": { "path": "own.alive", "eq": true }, "for": 15, "label": "15 s turning onto 110 and holding it" },
    { "mark": { "label": "back" } },
    { "fly": { "mode": "hold", "alt_msl_m": 3000, "hdg_deg": 90, "throttle": 1 } },
    { "check": { "path": "own.alive", "eq": true }, "for": 15, "label": "15 s back onto 090" },
    { "record": { "path": "own.mach" }, "label": "Mach at the end" },
    { "record": { "path": "own.tas_mps" }, "label": "TAS at the end, m/s" },
  ],
}
