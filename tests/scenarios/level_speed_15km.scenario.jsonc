// Level top speed at 15 km, full afterburner. The offline aero model predicts 816.9 m/s, Mach 2.817 (the game's speed of
// sound is 290 m/s above 10 km), for a clean 7,000 kg Icarus, about half fuel. The Icarus starts over Ignus at 15 km, heading
// east at 700 m/s with full fuel and about 160 km of map ahead; a hold keeps 15 km at throttle 1 (the afterburner runs from
// 0.90 to 1.00). Full afterburner drains 2,400 kg in about 300 s, so half fuel comes about 150 s in, about 120 km east.
// Records Mach and TAS at half fuel (the predicted case) and again at 40% fuel, about 30 s later: the two agree within
// 0.01 Mach once the speed has settled. Pass: Mach at half fuel within 3% of 2.817 (2.73 to 2.90), level within 300 m; the
// verdict is MEASURED with the records, or FAIL outside the band. The airframe must be intact 5 s after spawn, else FAIL.
// From the repo root: no-agentic run tests/scenarios/level_speed_15km.scenario.jsonc
{
  "mission": "icarus_ignus_15km.mission.json",
  "mods": "clean",
  "plugins": [
    "installed:com.nikkorap.blueprinter",
    "../../.cache/build-staging/dotnet",
    "content:../../build/icarus_0.2.0.nobp host=com.nikkorap.blueprinter keys=baanish_icarus",
  ],
  "measure": true,
  "sample_hz": 2,
  "timeout": 420,
  "steps": [
    { "require": { "path": "mods.baanish.icarus.loadout", "eq": "||" }, "within": 3,
      "label": "loadout: all three hardpoint sets empty" },
    { "require": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.type", "eq": "baanish_icarus" }, { "path": "own.alt_msl_m", "gt": 14500 } ] },
      "label": "the Icarus airborne at 15 km" },
    { "mark": { "label": "start" } },
    { "check": { "all": [ { "path": "own.hp_frac", "eq": 1 }, { "not": { "event": "part_detached", "since": "start" } } ] }, "for": 5,
      "label": "the airframe is intact 5 s after spawn" },
    { "require": { "path": "own.hp_frac", "eq": 1 }, "label": "gate: the steps after need an intact airframe" },
    { "fly": { "mode": "hold", "alt_msl_m": 15000, "hdg_deg": 90, "throttle": 1 } },
    { "time": { "scale": 4 } },
    { "wait": { "path": "own.fuel_frac", "lt": 0.5 }, "timeout": 240, "label": "half fuel, about 7,000 kg" },
    { "check": { "path": "own.mach", "between": [2.73, 2.9] }, "label": "Mach at half fuel within 3% of the offline aero model's predicted 2.817" },
    { "record": { "path": "own.mach" }, "label": "Mach at half fuel (target 2.82)" },
    { "record": { "path": "own.tas_mps" }, "label": "TAS at half fuel, m/s (target 817)" },
    { "record": { "path": "own.alt_msl_m" }, "label": "altitude at half fuel, m" },
    { "record": { "path": "own.engines.0.thrust_n" }, "label": "thrust at half fuel, N" },
    { "wait": { "path": "own.fuel_frac", "lt": 0.4 }, "timeout": 60, "label": "40% fuel" },
    { "record": { "path": "own.mach" }, "label": "Mach at 40% fuel (settled if within 0.01 of half fuel's)" },
    { "record": { "path": "own.alt_msl_m" }, "label": "altitude at 40% fuel, m" },
    { "record": { "path": "own.pos.x" }, "label": "x at 40% fuel, m (map edge 81,920)" },
    { "time": { "scale": 1 } },
    { "check": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.alt_msl_m", "near": 15000, "tol": 300 } ] },
      "label": "alive and within 300 m of 15 km at the end" },
  ],
}
