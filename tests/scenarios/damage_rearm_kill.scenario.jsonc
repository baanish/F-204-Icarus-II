// Ten rearms, then a missile kill: the Icarus spawns with its default loadout and the plugin's [Diagnostics]
// ReloadLoadout hands it a fresh copy of that loadout ten times, as ten rearms with a loadout change in one session do.
// Unit.RegisterDamageable only appends, and damage and break messages address a part by its byte index in that list,
// so the count after ten must stay under 256. Then a Boscali AAM2 from behind and to the left hits it: the parts the
// game detaches (part_detached) must be the ones the plugin's "part-detached" lines name, each with one id under 256:
// after the run, python tools/detach_check.py rearm <run>.
// From the repo root: no-agentic run tests/scenarios/damage_rearm_kill.scenario.jsonc
{
  "mission": "icarus_default_loadout.mission.json",
  "mods": "clean",
  "plugins": [
    "installed:com.nikkorap.blueprinter",
    "../../.cache/build-staging/dotnet",
    "content:../../build/icarus_0.2.0.nobp host=com.nikkorap.blueprinter keys=baanish_icarus",
  ],
  "measure": true,
  "timeout": 180,
  "steps": [
    {"require": {"all": [{"path": "own.alive", "eq": true}, {"path": "own.type", "eq": "baanish_icarus"}]}, "label": "the Icarus is the player's aircraft"},
    {"fly": {"mode": "hold", "alt_msl_m": 10000, "hdg_deg": 90, "throttle": 0.8}},
    {"mark": {"label": "reload1"}},
    {"config": {"guid": "baanish.icarus", "section": "Diagnostics", "key": "ReloadLoadout", "value": 1}},
    {"wait": {"log": "after a loadout spawn$", "source": "F-204 Icarus II", "since": "reload1"}, "timeout": 5, "label": "reload 1 respawns the mounts"},
    {"mark": {"label": "reload2"}},
    {"config": {"guid": "baanish.icarus", "section": "Diagnostics", "key": "ReloadLoadout", "value": 2}},
    {"wait": {"log": "after a loadout spawn$", "source": "F-204 Icarus II", "since": "reload2"}, "timeout": 5, "label": "reload 2 respawns the mounts"},
    {"mark": {"label": "reload3"}},
    {"config": {"guid": "baanish.icarus", "section": "Diagnostics", "key": "ReloadLoadout", "value": 3}},
    {"wait": {"log": "after a loadout spawn$", "source": "F-204 Icarus II", "since": "reload3"}, "timeout": 5, "label": "reload 3 respawns the mounts"},
    {"mark": {"label": "reload4"}},
    {"config": {"guid": "baanish.icarus", "section": "Diagnostics", "key": "ReloadLoadout", "value": 4}},
    {"wait": {"log": "after a loadout spawn$", "source": "F-204 Icarus II", "since": "reload4"}, "timeout": 5, "label": "reload 4 respawns the mounts"},
    {"mark": {"label": "reload5"}},
    {"config": {"guid": "baanish.icarus", "section": "Diagnostics", "key": "ReloadLoadout", "value": 5}},
    {"wait": {"log": "after a loadout spawn$", "source": "F-204 Icarus II", "since": "reload5"}, "timeout": 5, "label": "reload 5 respawns the mounts"},
    {"mark": {"label": "reload6"}},
    {"config": {"guid": "baanish.icarus", "section": "Diagnostics", "key": "ReloadLoadout", "value": 6}},
    {"wait": {"log": "after a loadout spawn$", "source": "F-204 Icarus II", "since": "reload6"}, "timeout": 5, "label": "reload 6 respawns the mounts"},
    {"mark": {"label": "reload7"}},
    {"config": {"guid": "baanish.icarus", "section": "Diagnostics", "key": "ReloadLoadout", "value": 7}},
    {"wait": {"log": "after a loadout spawn$", "source": "F-204 Icarus II", "since": "reload7"}, "timeout": 5, "label": "reload 7 respawns the mounts"},
    {"mark": {"label": "reload8"}},
    {"config": {"guid": "baanish.icarus", "section": "Diagnostics", "key": "ReloadLoadout", "value": 8}},
    {"wait": {"log": "after a loadout spawn$", "source": "F-204 Icarus II", "since": "reload8"}, "timeout": 5, "label": "reload 8 respawns the mounts"},
    {"mark": {"label": "reload9"}},
    {"config": {"guid": "baanish.icarus", "section": "Diagnostics", "key": "ReloadLoadout", "value": 9}},
    {"wait": {"log": "after a loadout spawn$", "source": "F-204 Icarus II", "since": "reload9"}, "timeout": 5, "label": "reload 9 respawns the mounts"},
    {"mark": {"label": "reload10"}},
    {"config": {"guid": "baanish.icarus", "section": "Diagnostics", "key": "ReloadLoadout", "value": 10}},
    {"wait": {"log": "after a loadout spawn$", "source": "F-204 Icarus II", "since": "reload10"}, "timeout": 5, "label": "reload 10 respawns the mounts"},
    {"record": {"log_value": {"match": "damage-registrations \\S+: (\\d+) before a reload", "source": "F-204 Icarus II", "since": "reload1"}}, "label": "registrations at spawn"},
    {"check": {"log_value": {"match": "damage-registrations \\S+: (\\d+) after a loadout spawn", "source": "F-204 Icarus II", "since": "reload10", "lt": 256}}, "label": "registrations after ten rearms stay under 256, the byte damage and break messages address a part by"},
    {"record": {"log_value": {"match": "damage-registrations \\S+: (\\d+) after a loadout spawn", "source": "F-204 Icarus II", "since": "reload10"}}, "label": "registrations after ten rearms"},
    {"camera": {"mode": "orbit", "target": "own", "distance_m": 40, "hdg_deg": 120, "pitch_deg": 10}},
    {"spawn": {"kind": "missile", "type": "AAM2", "faction": "Boscali", "back_m": 3000, "left_m": 1500, "speed_mps": 600, "name": "m1"}},
    {"mark": {"label": "launched"}},
    {"wait": {"event": "missile_end", "since": "launched"}, "timeout": 40, "label": "the missile ends"},
    {"check": {"event": "missile_end", "since": "launched", "result": "hit"}, "label": "the missile hits the Icarus"},
    {"wait": {"path": "sample_ms", "gt": -1}, "hold": 15, "timeout": 20, "label": "15 s after the hit"},
    {"check": {"log": "joint-break \\S+: joint broke", "source": "F-204 Icarus II", "since": "launched"}, "label": "a part's joint broke and the plugin named it"},
    {"record": {"event": "part_detached", "field": "part", "since": "launched"}, "label": "parts detached after the hit"},
  ],
}
