// Tip tanks across two peers: a host and a client on this PC, each flying an Icarus with a tip tank on each wingtip
// (icarus_group_tanks.mission.json). The right tank hangs upside down from its rolled hardpoint until the plugin turns it
// back as the mount spawns (src/Icarus/TipTanks.cs, "tip-tank-flip" stage lines at spawn); it uses only the geometry the game builds,
// so no message is sent. Pass: on each peer, every Icarus's tanks are hung (periodic "tip-tank-pose" lines) upright
// (up and forward within 0.0001 of the aircraft's) at the old place (3.630, -0.562, -2.725) in the aircraft frame to
// 2 mm; then the host fires its tanks, and the client, who only sees them, logs each round spawning upright and 0.3 m
// outboard; both Icaruses stay undamaged, nobody drops, and no joint breaks.
// From the repo root: no-agentic run tests/scenarios/icarus_tip_tank_peers.scenario.jsonc
{
  "mission": "icarus_group_tanks.mission.json",
  "peers": {
    "host": {
      "role": "host", "mods": "clean",
      "plugins": [
        "installed:com.nikkorap.blueprinter",
        "../../.cache/build-staging/dotnet",
        "content:../../build/icarus_0.1.0.nobp host=com.nikkorap.blueprinter keys=baanish_icarus",
      ],
    },
    "client": {
      "role": "client", "mods": "clean",
      "plugins": [
        "installed:com.nikkorap.blueprinter",
        "../../.cache/build-staging/dotnet",
        "content:../../build/icarus_0.1.0.nobp host=com.nikkorap.blueprinter keys=baanish_icarus",
      ],
    },
  },
  "timeout": 300,
  "steps": [
    { "require": { "path": "net.players", "eq": 2 }, "within": 60, "label": "host and client both in" },
    { "require": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.type", "eq": "baanish_icarus" } ] }, "label": "the host flies an Icarus" },
    { "require": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.type", "eq": "baanish_icarus" } ] }, "on": "client", "label": "the client flies an Icarus" },
    { "mark": { "label": "start" } },
    { "mark": { "label": "start" }, "on": "client" },
    { "check": { "all": [ { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose L \\d+: tip tank L hangs at \\((-?[\\d.]+), -?[\\d.]+, -?[\\d.]+\\), up -?[\\d.]+, forward -?[\\d.]+$", "source": "F-204 Icarus II", "between": [-3.632, -3.628] } },
                          { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose L \\d+: tip tank L hangs at \\(-?[\\d.]+, (-?[\\d.]+), -?[\\d.]+\\), up -?[\\d.]+, forward -?[\\d.]+$", "source": "F-204 Icarus II", "between": [-0.564, -0.560] } },
                          { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose L \\d+: tip tank L hangs at \\(-?[\\d.]+, -?[\\d.]+, (-?[\\d.]+)\\), up -?[\\d.]+, forward -?[\\d.]+$", "source": "F-204 Icarus II", "between": [-2.727, -2.723] } },
                          { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose L \\d+: tip tank L hangs at \\(-?[\\d.]+, -?[\\d.]+, -?[\\d.]+\\), up (-?[\\d.]+), forward -?[\\d.]+$", "source": "F-204 Icarus II", "gt": 0.9999 } },
                          { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose L \\d+: tip tank L hangs at \\(-?[\\d.]+, -?[\\d.]+, -?[\\d.]+\\), up -?[\\d.]+, forward (-?[\\d.]+)$", "source": "F-204 Icarus II", "gt": 0.9999 } } ] }, "within": 15,
      "label": "the host sees the left tank kept, upright, at its old place (3.630, -0.562, -2.725) to 2 mm" },
    { "check": { "all": [ { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose R \\d+: tip tank R hangs at \\((-?[\\d.]+), -?[\\d.]+, -?[\\d.]+\\), up -?[\\d.]+, forward -?[\\d.]+$", "source": "F-204 Icarus II", "between": [3.628, 3.632] } },
                          { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose R \\d+: tip tank R hangs at \\(-?[\\d.]+, (-?[\\d.]+), -?[\\d.]+\\), up -?[\\d.]+, forward -?[\\d.]+$", "source": "F-204 Icarus II", "between": [-0.564, -0.560] } },
                          { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose R \\d+: tip tank R hangs at \\(-?[\\d.]+, -?[\\d.]+, (-?[\\d.]+)\\), up -?[\\d.]+, forward -?[\\d.]+$", "source": "F-204 Icarus II", "between": [-2.727, -2.723] } },
                          { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose R \\d+: tip tank R hangs at \\(-?[\\d.]+, -?[\\d.]+, -?[\\d.]+\\), up (-?[\\d.]+), forward -?[\\d.]+$", "source": "F-204 Icarus II", "gt": 0.9999 } },
                          { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose R \\d+: tip tank R hangs at \\(-?[\\d.]+, -?[\\d.]+, -?[\\d.]+\\), up -?[\\d.]+, forward (-?[\\d.]+)$", "source": "F-204 Icarus II", "gt": 0.9999 } } ] }, "within": 15,
      "label": "the host sees the right tank turned, upright, at its old place (3.630, -0.562, -2.725) to 2 mm" },
    { "check": { "all": [ { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose L \\d+: tip tank L hangs at \\((-?[\\d.]+), -?[\\d.]+, -?[\\d.]+\\), up -?[\\d.]+, forward -?[\\d.]+$", "source": "F-204 Icarus II", "between": [-3.632, -3.628] } },
                          { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose L \\d+: tip tank L hangs at \\(-?[\\d.]+, (-?[\\d.]+), -?[\\d.]+\\), up -?[\\d.]+, forward -?[\\d.]+$", "source": "F-204 Icarus II", "between": [-0.564, -0.560] } },
                          { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose L \\d+: tip tank L hangs at \\(-?[\\d.]+, -?[\\d.]+, (-?[\\d.]+)\\), up -?[\\d.]+, forward -?[\\d.]+$", "source": "F-204 Icarus II", "between": [-2.727, -2.723] } },
                          { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose L \\d+: tip tank L hangs at \\(-?[\\d.]+, -?[\\d.]+, -?[\\d.]+\\), up (-?[\\d.]+), forward -?[\\d.]+$", "source": "F-204 Icarus II", "gt": 0.9999 } },
                          { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose L \\d+: tip tank L hangs at \\(-?[\\d.]+, -?[\\d.]+, -?[\\d.]+\\), up -?[\\d.]+, forward (-?[\\d.]+)$", "source": "F-204 Icarus II", "gt": 0.9999 } } ] }, "on": "client", "within": 15,
      "label": "the client sees the left tank kept, upright, at its old place (3.630, -0.562, -2.725) to 2 mm" },
    { "check": { "all": [ { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose R \\d+: tip tank R hangs at \\((-?[\\d.]+), -?[\\d.]+, -?[\\d.]+\\), up -?[\\d.]+, forward -?[\\d.]+$", "source": "F-204 Icarus II", "between": [3.628, 3.632] } },
                          { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose R \\d+: tip tank R hangs at \\(-?[\\d.]+, (-?[\\d.]+), -?[\\d.]+\\), up -?[\\d.]+, forward -?[\\d.]+$", "source": "F-204 Icarus II", "between": [-0.564, -0.560] } },
                          { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose R \\d+: tip tank R hangs at \\(-?[\\d.]+, -?[\\d.]+, (-?[\\d.]+)\\), up -?[\\d.]+, forward -?[\\d.]+$", "source": "F-204 Icarus II", "between": [-2.727, -2.723] } },
                          { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose R \\d+: tip tank R hangs at \\(-?[\\d.]+, -?[\\d.]+, -?[\\d.]+\\), up (-?[\\d.]+), forward -?[\\d.]+$", "source": "F-204 Icarus II", "gt": 0.9999 } },
                          { "log_value": { "match": "^\\[Icarus\\] tip-tank-pose R \\d+: tip tank R hangs at \\(-?[\\d.]+, -?[\\d.]+, -?[\\d.]+\\), up -?[\\d.]+, forward (-?[\\d.]+)$", "source": "F-204 Icarus II", "gt": 0.9999 } } ] }, "on": "client", "within": 15,
      "label": "the client sees the right tank turned, upright, at its old place (3.630, -0.562, -2.725) to 2 mm" },
    { "fly": { "mode": "hold", "alt_msl_m": 3000, "hdg_deg": 0, "throttle": 0.8 } },
    { "fly": { "mode": "hold", "alt_msl_m": 3000, "hdg_deg": 0, "throttle": 0.8 }, "on": "client" },
    { "wait": { "path": "own.alive", "eq": true }, "timeout": 12, "hold": 8, "label": "both fly their holds" },
    { "act": { "station": 0 } },
    { "check": { "all": [ { "path": "own.station.name", "eq": "Tip Tank" }, { "path": "own.station.ammo", "eq": 2 }, { "path": "own.station.safety", "eq": false } ] },
      "within": 3, "label": "the host's tank station is selected with both tanks, safety off" },
    { "mark": { "label": "release" } },
    { "mark": { "label": "release" }, "on": "client" },
    { "act": { "fire": 0.2 } },
    { "check": { "log_value": { "match": "^\\[Icarus\\] tip-tanks-release: tip tank R released with (\\d+) kg", "source": "F-204 Icarus II", "since": "release", "between": [0, 500] } },
      "within": 3, "label": "the host's pair released" },
    { "check": { "all": [ { "log_value": { "match": "^\\[Icarus\\] tip-tanks-round: tip tank round L from \\d+ dressed in the jet's livery, spawned at \\((-?[\\d.]+),", "source": "F-204 Icarus II", "since": "release", "between": [-4.1, -3.85] } },
                          { "log_value": { "match": "^\\[Icarus\\] tip-tanks-round: tip tank round L .*, up (-?[\\d.]+)$", "source": "F-204 Icarus II", "since": "release", "gt": 0.999 } } ] }, "on": "client", "within": 15,
      "label": "the client sees the host's left round spawn upright, 0.3 m outboard" },
    { "check": { "all": [ { "log_value": { "match": "^\\[Icarus\\] tip-tanks-round: tip tank round R from \\d+ dressed in the jet's livery, spawned at \\((-?[\\d.]+),", "source": "F-204 Icarus II", "since": "release", "between": [3.85, 4.1] } },
                          { "log_value": { "match": "^\\[Icarus\\] tip-tanks-round: tip tank round R .*, up (-?[\\d.]+)$", "source": "F-204 Icarus II", "since": "release", "gt": 0.999 } } ] }, "on": "client", "within": 15,
      "label": "the client sees the host's right round spawn upright, 0.3 m outboard" },
    { "check": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.hp_frac", "gt": 0.999 }, { "not": { "event": "damage", "since": "release" } } ] }, "for": 8,
      "label": "the host's Icarus takes no damage after the release" },
    { "check": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.hp_frac", "gt": 0.999 }, { "not": { "event": "damage", "since": "release" } } ] }, "on": "client", "for": 3,
      "label": "the client's Icarus takes no damage after the host's release" },
    { "check": { "not": { "log": "joint-break", "since": "start" } }, "label": "no joint broke on the host" },
    { "check": { "not": { "log": "joint-break", "since": "start" } }, "on": "client", "label": "no joint broke on the client" },
    { "check": { "path": "net.players", "eq": 2 }, "label": "both still in" },
  ],
}
