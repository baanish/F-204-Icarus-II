// DRAFT exploratory run
{
  "mission": "icarus_helipad.mission.json",
  "peers": {
    "host": {
      "role": "host", "mods": "clean",
      "config": { "baanish.icarus": { "Fun": { "HelipadSpawn": true } } },
      "spawn_at": { "faction": "Primeva", "airbase": "South Boscali General Aviation", "aircraft": "baanish_icarus" },
      "plugins": [
        "installed:com.nikkorap.blueprinter",
        "../../.cache/build-staging/dotnet",
        "content:../../build/icarus_0.2.0.nobp host=com.nikkorap.blueprinter keys=baanish_icarus",
      ],
    },
    "client": {
      "role": "client", "mods": "clean",
      "config": { "baanish.icarus": { "Fun": { "HelipadSpawn": true } } },
      "spawn_at": { "faction": "Primeva", "airbase": "South Boscali General Aviation", "aircraft": "baanish_icarus" },
      "plugins": [
        "installed:com.nikkorap.blueprinter",
        "../../.cache/build-staging/dotnet",
        "content:../../build/icarus_0.2.0.nobp host=com.nikkorap.blueprinter keys=baanish_icarus",
      ],
    },
  },
  "measure": true,
  "timeout": 300,
  "steps": [
    { "require": { "path": "net.players", "eq": 2 }, "within": 60, "label": "host and client both in" },
    { "require": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.type", "eq": "baanish_icarus" } ] }, "label": "host flies an Icarus" },
    { "require": { "all": [ { "path": "own.alive", "eq": true }, { "path": "own.type", "eq": "baanish_icarus" } ] }, "on": "client", "label": "client flies an Icarus" },
    { "mark": { "label": "pad" } },
    { "mark": { "label": "pad" }, "on": "client" },
    { "record": { "path": "own.pos.x" }, "label": "host x" },
    { "record": { "path": "own.pos.y" }, "label": "host y" },
    { "record": { "path": "own.pos.z" }, "label": "host z" },
    { "record": { "path": "own.pitch_deg" }, "label": "host pitch" },
    { "record": { "path": "own.roll_deg" }, "label": "host roll" },
    { "record": { "path": "own.hdg_deg" }, "label": "host hdg" },
    { "record": { "path": "own.gear" }, "label": "host gear" },
    { "record": { "path": "own.hp_frac" }, "label": "host hp" },
    { "record": { "path": "own.alt_agl_m" }, "label": "host agl" },
    { "record": { "path": "own.pos.x" }, "on": "client", "label": "client x" },
    { "record": { "path": "own.pos.y" }, "on": "client", "label": "client y" },
    { "record": { "path": "own.pos.z" }, "on": "client", "label": "client z" },
    { "record": { "path": "own.pitch_deg" }, "on": "client", "label": "client pitch" },
    { "record": { "path": "own.roll_deg" }, "on": "client", "label": "client roll" },
    { "record": { "path": "own.hdg_deg" }, "on": "client", "label": "client hdg" },
    { "record": { "path": "own.gear" }, "on": "client", "label": "client gear" },
    { "record": { "path": "own.hp_frac" }, "on": "client", "label": "client hp" },
    { "record": { "path": "own.alt_agl_m" }, "on": "client", "label": "client agl" },
    { "check": { "path": "own.hp_frac", "gt": 0 }, "for": 20, "label": "idle 20 s" },
    { "record": { "path": "own.pos.y" }, "label": "host y +20" },
    { "record": { "path": "own.pitch_deg" }, "label": "host pitch +20" },
    { "record": { "path": "own.pos.y" }, "on": "client", "label": "client y +20" },
    { "record": { "path": "own.pitch_deg" }, "on": "client", "label": "client pitch +20" },
  ],
}
